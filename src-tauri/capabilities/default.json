{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/fswatch",
          "sidecar": true
        }
      ]
    },
    "dialog:default",
    "fs:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "log:default"
  ]
}
