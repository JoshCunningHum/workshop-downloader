{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Workshop Downloader",
  "version": "0.2.0",
  "identifier": "com.kenshi.workshopdownloader",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run sidecar && bun run dev",
    "beforeBuildCommand": "bun run sidecar && bun run generate"
  },
  "app": {
    "windows": [
      {
        "title": "Workshop Downloader",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/fswatch"
    ]
  }
}
